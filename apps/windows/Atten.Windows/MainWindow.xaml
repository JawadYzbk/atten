<Window
    x:Class="Atten.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atten.Windows"
    Title="Atten">
    <Grid x:Name="Root">
        <NavigationView x:Name="Navigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Studio" Tag="Studio" IsSelected="True" />
                <NavigationViewItem Content="Playground" Tag="Playground" />
                <NavigationViewItem Content="Voices" Tag="Voices" />
                <NavigationViewItem Content="Projects" Tag="Projects" />
                <NavigationViewItem Content="Exports" Tag="Exports" />
                <NavigationViewItem Content="Settings" Tag="Settings" />
            </NavigationView.MenuItems>

            <Grid Padding="28" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding GeneratingVisibility}"
                                 MinHeight="4" />
                </StackPanel>

                <!-- Studio Panel -->
                <Grid x:Name="StudioPanel" Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Create speech" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBox Header="Project title"
                                 Text="{Binding DraftTitle, Mode=TwoWay}"
                                 PlaceholderText="Untitled narration" />
                        <TextBox Header="Script"
                                 Text="{Binding DraftText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="360"
                                 PlaceholderText="Start writing or paste text here in any language (English, Arabic, Spanish, French, German, Japanese, etc.)..." />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="14" Padding="0,0,8,0">
                            <ComboBox Header="Model / Engine"
                                      ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <ComboBox Header="Language"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <ComboBox Header="Voice"
                                      ItemsSource="{Binding StudioVoices}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedVoiceID, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <Slider Header="Speed"
                                    Minimum="0.5"
                                    Maximum="2"
                                    StepFrequency="0.05"
                                    Value="{Binding Speed, Mode=TwoWay}" />

                            <ComboBox Header="Format"
                                      ItemsSource="{Binding Formats}"
                                      SelectedItem="{Binding Format, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <ComboBox Header="Acceleration"
                                      ItemsSource="{Binding DeviceModes}"
                                      SelectedItem="{Binding DeviceMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <Button x:Name="GenerateButton"
                                    Content="Generate Speech"
                                    Click="OnGenerateClicked"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,6,0,0" />

                            <Button Content="Cancel"
                                    Click="OnCancelClicked"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Playground Panel -->
                <StackPanel x:Name="PlaygroundPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Playground" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Explore voices, text-to-speech experimentation, and instant previews across all installed models." TextWrapping="Wrap" />
                </StackPanel>

                <!-- Voices Panel -->
                <Grid x:Name="VoicesPanel" Grid.Row="1" RowSpacing="14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Voices &amp; Languages" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBox Grid.Row="1"
                             Header="Filter voices"
                             Text="{Binding VoiceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search by voice name, language (e.g. Arabic, German), engine, or trait..." />
                    <ListView Grid.Row="2" ItemsSource="{Binding GroupedVoices}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoiceGroup">
                                <StackPanel Spacing="6" Margin="0,4,0,16">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind Header}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{x:Bind Voices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Voice">
                                                <Grid Padding="12,6" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Language}" Opacity="0.7" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Gender}" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" />
                                                    <Border Grid.Column="2" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Quality}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Projects Panel -->
                <Grid x:Name="ProjectsPanel" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{Binding Projects}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProjectRecord">
                                <StackPanel Padding="0,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind AudioPath}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Exports Panel -->
                <StackPanel x:Name="ExportsPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Exports" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Settings & Hugging Face Discovery Panel -->
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Settings &amp; Speech Models" Style="{StaticResource TitleTextBlockStyle}" />
                        
                        <TextBox Header="Export folder" Text="{Binding OutputDirectory, Mode=TwoWay}" />

                        <!-- Local Models Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Speech Engines &amp; Models" FontWeight="SemiBold" FontSize="16" />
                                
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Kokoro-82M (Default Engine)" FontWeight="SemiBold" />
                                        <TextBlock Text="Bundled offline model (English US/UK, Spanish, French, Italian, Portuguese, Japanese, Mandarin, Hindi)" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Installed" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="XTTS-v2 &amp; Multilingual Neural Models" FontWeight="SemiBold" />
                                        <TextBlock Text="High-quality neural model with Arabic (العربية), German, Russian, Turkish, Dutch, Polish and 16+ languages" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <Button x:Name="DownloadXttsButton"
                                            Grid.Column="1"
                                            Content="Download Model"
                                            Click="OnDownloadXttsClicked"
                                            VerticalAlignment="Center" />
                                    <Button x:Name="PauseXttsButton"
                                            Grid.Column="2"
                                            Content="Pause"
                                            Click="OnPauseXttsClicked"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <ProgressBar x:Name="XttsProgressBar"
                                             Value="{Binding DownloadProgress}"
                                             Maximum="100"
                                             MinHeight="8"
                                             Visibility="Collapsed" />

                                <Grid x:Name="XttsMetricsGrid" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DownloadSpeed}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="•" Opacity="0.5" FontSize="12" />
                                        <TextBlock Text="{Binding DownloadEta}" Opacity="0.8" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadSizeText}" Opacity="0.8" FontSize="12" />
                                </Grid>

                                <TextBlock x:Name="XttsProgressLabel"
                                           Text="{Binding DownloadStatus}"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Hugging Face Model Discovery Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Discover TTS Models from Hugging Face" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Popular community and neural TTS architectures, ratings, and language tags." Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Click="OnRefreshHfModelsClicked" VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding HfModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:HfModelInfo">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" />
                                                            <TextBlock Text="{x:Bind Author}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock Text="{x:Bind DownloadsText}" Opacity="0.8" FontSize="12" />
                                                            <TextBlock Text="•" Opacity="0.4" FontSize="12" />
                                                            <TextBlock Text="{x:Bind LikesText}" Opacity="0.8" FontSize="12" />
                                                            <TextBlock Text="⭐" FontSize="10" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Text="{x:Bind LanguagesText}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Installed"
                                                                   Visibility="{x:Bind IsInstalled}"
                                                                   Foreground="{ThemeResource SystemAccentColor}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="All models and speech synthesis run 100% locally. No cloud subscription or API key is required." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Interactive Media Player Bar (Bottom) -->
                <Border Grid.Row="2"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Visibility="{Binding PlayerVisibility}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Click="OnTogglePlayPauseClicked"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,8"
                                ToolTipService.ToolTip="Play / Pause">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="{Binding PlayPauseIcon}" FontSize="12" />
                                <TextBlock Text="{Binding PlayPauseLabel}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Title and Seek Slider -->
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayerTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <Slider Value="{Binding PlayerPosition, Mode=TwoWay}"
                                    Maximum="{Binding PlayerDuration}"
                                    ValueChanged="OnPlayerSeekValueChanged"
                                    PointerEntered="OnPlayerSeekPointerEntered"
                                    PointerCaptureLost="OnPlayerSeekPointerCaptureLost"
                                    Margin="0,-4,0,-4" />
                        </StackPanel>

                        <!-- Time text -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PlayerTimeText}"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"
                                   FontFamily="Consolas"
                                   FontSize="12" />

                        <!-- Reveal Button -->
                        <Button Grid.Column="3"
                                Content="Reveal in Folder"
                                Click="OnRevealClicked"
                                VerticalAlignment="Center" />

                        <!-- Close Button -->
                        <Button Grid.Column="4"
                                Click="OnClosePlayerClicked"
                                VerticalAlignment="Center"
                                Padding="8,6">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
