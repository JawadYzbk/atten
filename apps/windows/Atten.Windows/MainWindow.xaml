<Window
    x:Class="Atten.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atten.Windows"
    Title="Atten">
    <Grid x:Name="Root">
        <NavigationView x:Name="Navigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Studio" Tag="Studio" IsSelected="True" />
                <NavigationViewItem Content="Playground" Tag="Playground" />
                <NavigationViewItem Content="Voices" Tag="Voices" />
                <NavigationViewItem Content="Projects" Tag="Projects" />
                <NavigationViewItem Content="Exports" Tag="Exports" />
                <NavigationViewItem Content="Settings" Tag="Settings" />
            </NavigationView.MenuItems>

            <Grid Padding="28" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding GeneratingVisibility}"
                                 MinHeight="4" />
                </StackPanel>

                <Grid x:Name="StudioPanel" Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Create speech" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBox Header="Project title"
                                 Text="{Binding DraftTitle, Mode=TwoWay}"
                                 PlaceholderText="Untitled narration" />
                        <TextBox Header="Script"
                                 Text="{Binding DraftText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="360"
                                 PlaceholderText="Start writing or paste text here in any language (English, Arabic, Spanish, French, German, Japanese, etc.)..." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="16">
                        <ComboBox Header="Voice"
                                  ItemsSource="{Binding Voices}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedVoiceID, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <Slider Header="Speed"
                                Minimum="0.5"
                                Maximum="2"
                                StepFrequency="0.05"
                                Value="{Binding Speed, Mode=TwoWay}" />
                        <ComboBox Header="Format"
                                  ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding Format, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Header="Acceleration"
                                  ItemsSource="{Binding DeviceModes}"
                                  SelectedItem="{Binding DeviceMode, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <Button x:Name="GenerateButton"
                                Content="Generate Speech"
                                Click="OnGenerateClicked"
                                HorizontalAlignment="Stretch" />
                        <Button Content="Cancel"
                                Click="OnCancelClicked"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="PlaygroundPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Playground" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Explore voices, text-to-speech experimentation, and instant previews across all installed models." TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="VoicesPanel" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Voices &amp; Languages" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBox Grid.Row="1"
                             Header="Filter voices"
                             Text="{Binding VoiceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search by name, language (e.g. Arabic, German), trait, or gender..." />
                    <ListView Grid.Row="2" ItemsSource="{Binding FilteredVoices}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Voice">
                                <StackPanel Padding="0,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{x:Bind Language}" Opacity="0.8" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="ProjectsPanel" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{Binding Projects}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProjectRecord">
                                <StackPanel Padding="0,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind AudioPath}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel x:Name="ExportsPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Exports" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                        
                        <TextBox Header="Export folder" Text="{Binding OutputDirectory, Mode=TwoWay}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Speech Engines &amp; Models" FontWeight="SemiBold" FontSize="16" />
                                
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Kokoro-82M (Default Engine)" FontWeight="SemiBold" />
                                        <TextBlock Text="Bundled offline model (English US/UK, Spanish, French, Italian, Portuguese, Japanese, Mandarin, Hindi)" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Installed" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="XTTS-v2 &amp; Multilingual Neural Models" FontWeight="SemiBold" />
                                        <TextBlock Text="High-quality neural model with Arabic (العربية), German, Russian, Turkish, Dutch, Polish and 16+ languages" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <Button x:Name="DownloadXttsButton"
                                            Grid.Column="1"
                                            Content="Download Model"
                                            Click="OnDownloadXttsClicked"
                                            VerticalAlignment="Center" />
                                    <Button x:Name="PauseXttsButton"
                                            Grid.Column="2"
                                            Content="Pause"
                                            Click="OnPauseXttsClicked"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <ProgressBar x:Name="XttsProgressBar"
                                             Value="{Binding DownloadProgress}"
                                             Maximum="100"
                                             MinHeight="8"
                                             Visibility="Collapsed" />

                                <Grid x:Name="XttsMetricsGrid" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DownloadSpeed}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="•" Opacity="0.5" FontSize="12" />
                                        <TextBlock Text="{Binding DownloadEta}" Opacity="0.8" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadSizeText}" Opacity="0.8" FontSize="12" />
                                </Grid>

                                <TextBlock x:Name="XttsProgressLabel"
                                           Text="{Binding DownloadStatus}"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="All models and speech synthesis run 100% locally. No cloud subscription or API key is required." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Play Output" Click="OnPlayClicked" />
                    <Button Content="Reveal Output" Click="OnRevealClicked" />
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
